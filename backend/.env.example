# Application Settings
APP_NAME=PetroPulse AI Backend
VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Settings (SQLite for development)
DATABASE_URL=sqlite:///./petropulse.db

# Redis Settings (Optional - set to empty string to disable)
REDIS_URL=redis://localhost:6379/0

# Celery Settings (Optional - requires Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Seed Settings
SEED_ON_STARTUP=True
SEED_HISTORY_MONTHS=36
SEED_RANDOM_SEED=42

# Simulation Settings
SIMULATION_TICK_SECONDS=2.0
SIMULATION_MAX_SESSIONS=16
